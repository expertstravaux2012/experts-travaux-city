# Fonction Vercel /api/rdv : envoi d'un e-mail par Mailjet (variables serveur, jamais PUBLIC_).
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Adresse expéditeur validée dans Mailjet.
MAILJET_SENDER_EMAIL=
# Destinataire des demandes (défaut si absent : site.email de src/data/site.ts).
RDV_TO_EMAIL=
# Cloudflare Turnstile : clé publique (côté navigateur) et clé secrète (serveur, jamais PUBLIC_).
# Sans clé secrète, /api/rdv refuse toute demande (production et previews) ; toléré seulement en développement local ou VERCEL_ENV=development. Les deux clés vont ensemble.
# La clé publique n'est pas secrète : à définir en local (.env) et dans Vercel (variable lue au build).
PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
