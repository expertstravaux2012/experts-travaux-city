---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PorteIntro from '../components/layout/PorteIntro.astro';
import CurseurSuivi from '../components/layout/CurseurSuivi.astro';
import RailSalles from '../components/layout/RailSalles.astro';
import PlanSalles from '../components/layout/PlanSalles.astro';
import Hero from '../components/sections/Hero.astro';
import Entree from '../components/sections/Entree.astro';
import Salles from '../components/sections/Salles.astro';
import Parcours from '../components/sections/Parcours.astro';
import Marque from '../components/sections/Marque.astro';
import RdvSection from '../components/sections/RdvSection.astro';
import { seo } from '../data/seo';
import { site } from '../data/site';
---

<Layout title={seo.home.title} description={seo.home.description} path="/">
  <PorteIntro />
  <Header />
  <main id="main">
    {site.showHelix ? <Hero /> : <Entree />}
    <Salles />
    <Parcours />
    <Marque />
    <RdvSection />
  </main>
  <Footer />
  <CurseurSuivi />
  <RailSalles />
  <PlanSalles part="dialog" />
</Layout>
