---
// Préloader : le cube se dessine, la photo apparaît dans sa silhouette, puis le rideau se lève en biais.
// Une seule fois par session ; ignoré si mouvement réduit ; sans JS il reste invisible.
import { site } from '../../data/site';
const pts = '100,12 182,58 182,162 100,208 18,162 18,58';
---

<script is:inline>
  try {
    var r = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!r && !sessionStorage.getItem('city-pre') && location.pathname === '/') {
      document.documentElement.classList.add('preload');
      sessionStorage.setItem('city-pre', '1');
      setTimeout(function () { document.documentElement.classList.remove('preload'); }, 3600);
    }
  } catch (e) {}
</script>

<div class="preloader" aria-hidden="true">
  <div class="pre-inner">
    <svg viewBox="0 0 200 220" class="pre-cube">
      <defs><clipPath id="pre-clip"><polygon points={pts}></polygon></clipPath></defs>
      <g clip-path="url(#pre-clip)"><image href="/assets/city/choix_salle_de_bain_showroom_toulouse-1600.webp" x="-20" y="0" width="240" height="220" preserveAspectRatio="xMidYMid slice" class="pre-img"></image></g>
      <polygon points={pts} fill="none" stroke-width="3" pathLength="100" class="pre-stroke"></polygon>
      <polyline points="18,58 100,110 182,58" fill="none" stroke-width="3" class="pre-edge"></polyline>
      <line x1="100" y1="110" x2="100" y2="208" stroke-width="3" class="pre-edge"></line>
    </svg>
    <p class="pre-name"><span>{site.name.replace(' City', '')}</span> <b>City</b></p>
  </div>
</div>

<style is:global>
  .preloader { display: none; }
  html.preload { overflow: hidden; }
  html.preload .preloader {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: var(--z-preloader); background: var(--color-face-deep);
    animation: pre-out 0.9s cubic-bezier(0.77, 0, 0.18, 1) 2.5s forwards;
  }
  .pre-inner { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  .pre-cube { width: min(46vw, 15rem); height: auto; overflow: visible; }
  .pre-stroke { stroke: var(--color-city-on-dark); stroke-dasharray: 100; stroke-dashoffset: 100; animation: pre-draw 1.1s ease-out 0.15s forwards; }
  .pre-img { opacity: 0; transform-origin: center; animation: pre-img 1.3s ease-out 0.9s forwards; }
  .pre-edge { stroke: var(--color-face-deep); opacity: 0; animation: pre-fade 0.4s ease 1.4s forwards; }
  .pre-name { color: var(--color-stone); font: 300 0.95rem/1 var(--font-display); letter-spacing: var(--tracking-spaced); opacity: 0; animation: pre-fade 0.6s ease 1.5s forwards; }
  .pre-name b { font: 300 1.1rem/1 var(--font-display); letter-spacing: var(--tracking-spaced); color: var(--color-city-on-dark); }
  @keyframes pre-draw { to { stroke-dashoffset: 0; } }
  @keyframes pre-img { from { opacity: 0; transform: scale(1.35); } to { opacity: 1; transform: scale(1); } }
  @keyframes pre-fade { to { opacity: 1; } }
  @keyframes pre-out { to { clip-path: polygon(0 0, 100% 0, 100% 0, 0 -12%); visibility: hidden; } }
  html.preload .preloader { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); }
</style>
