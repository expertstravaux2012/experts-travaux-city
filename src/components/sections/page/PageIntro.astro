---
// En-tête de page : fil d'Ariane (slot "breadcrumb"), H1 unique, intro, actions (slot par défaut).
interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
---

<section class="bg-face-deep pb-intro pt-header text-stone">
  <div class="mx-auto max-w-site px-margin pb-space-xl pt-space-lg desktop:pb-space-2xl">
    <slot name="breadcrumb" />
    <div class="mt-space-lg grid grid-cols-1 gap-space-lg desktop:grid-cols-12 desktop:items-end desktop:gap-gutter">
      <h1 class="text-balance font-display text-display-xl-mobile desktop:col-span-8 desktop:text-display-xl">
        {title}
      </h1>
      <div class="flex flex-col gap-space-lg desktop:col-span-4">
        <p class="text-body-lg text-stone/85">{intro}</p>
        <div class="flex flex-wrap gap-space-md"><slot /></div>
      </div>
    </div>
  </div>
</section>
