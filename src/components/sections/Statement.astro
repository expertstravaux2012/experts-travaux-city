---
// Accroche dont les mots montent puis s'allument au scroll, puis paragraphe, CTA et grille des univers.
import { statement, universTitle } from '../../data/home';
import { realisations } from '../../data/realisations';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
// Seule l'espace ordinaire sépare les mots ; la ponctuation haute reste collée au mot précédent (jamais allumée seule).
const words = statement.text.replace(/ ([:;?!])/g, '\u00a0$1').split(' ');
const highlight: readonly string[] = statement.highlight;
const split = (w: string) => {
  const [, lead, core, trail] = w.match(/^([^\p{L}\p{N}]*)(.*?)([^\p{L}\p{N}]*)$/su)!;
  return { lead, core, trail, hl: highlight.includes(core.replace(/[^\p{L}\p{N}-]/gu, '')) };
};
---

<Section tone="dark" id="showroom">
  <p class="statement text-balance font-display text-statement font-light tracking-tight" data-statement>
    {words.map((w, i) => {
      const { lead, core, trail, hl } = split(w);
      return (
      <>
        <span class="word" style={`--i:${i}`}>
          <span class="word-in">{lead}{hl ? <span data-hl>{core}</span> : core}{trail}</span>
        </span>
        {' '}
      </>
      );
    })}
  </p>
  <p class="mt-space-lg max-w-prose text-body-lg text-stone/90">{statement.body}</p>
  <div class="mt-space-lg">
    <Button variant="accent" href={statement.cta.href} icon="arrow-right">{statement.cta.label}</Button>
  </div>
  <h2 id="univers-title" class="mt-space-xl text-balance font-display text-headline-lg-mobile font-light text-stone md:text-headline-lg desktop:mt-space-2xl">{universTitle}</h2>
  <ul aria-labelledby="univers-title" class="mt-space-lg grid grid-cols-1 gap-x-space-lg gap-y-space-lg md:grid-cols-2 desktop:grid-cols-3 desktop:gap-x-gutter" role="list">
    {
      realisations.map((r) => (
        <li class="flex flex-col gap-space-sm border-t-2 border-city pt-space-md">
          <h3 class="font-display text-headline-sm text-city-on-dark">{r.categorie}</h3>
          <p class="max-w-prose text-body-md text-stone/90">{r.description}</p>
        </li>
      ))
    }
  </ul>
</Section>

<style is:global>
  .statement .word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-block: var(--spacing-space-sm);
    margin-block: calc(var(--spacing-space-sm) * -1);
    transition: opacity 0.25s linear, color 0.25s linear;
    opacity: var(--o, 1);
  }
  .statement .word [data-hl] { color: var(--color-city-on-dark); }
  .statement.is-track .word:not([data-lit]) [data-hl] { color: inherit; }
  .statement .word-in { display: block; }
  .statement.is-reveal .word-in {
    transform: translateY(var(--reveal-from));
    transition: transform var(--reveal-duration) var(--reveal-ease);
    transition-delay: calc(var(--i) * var(--reveal-stagger));
  }
  .statement.is-reveal.is-revealed .word-in { transform: none; }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-statement]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ws = [...el.querySelectorAll<HTMLElement>('.word')];
    el.classList.add('is-track');
    const upd = () => {
      const r = el.getBoundingClientRect(), vh = innerHeight;
      const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (vh * 0.25)));
      ws.forEach((w, i) => {
        const lit = p * ws.length > i + 0.5;
        w.style.setProperty('--o', lit ? '1' : 'var(--opacity-unlit)');
        w.toggleAttribute('data-lit', lit);
      });
    };
    upd();
    addEventListener('scroll', upd, { passive: true });
    addEventListener('resize', upd);

    if ('IntersectionObserver' in window) {
      el.classList.add('is-reveal');
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        el.classList.add('is-revealed');
        io.unobserve(el);
      }, { threshold: 0.2 });
      io.observe(el);
    }
  }
</script>
