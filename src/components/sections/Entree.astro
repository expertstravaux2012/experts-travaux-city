---
// Salle 00 : entrée du showroom. Porte le H1 de la page (marque + précision lisible par les moteurs).
import { entree, salles, salleSur, etapes } from '../../data/salles';
import { hero } from '../../data/home';
import { realisations } from '../../data/realisations';
import Salle from '../ui/Salle.astro';
import Pastille from '../ui/Pastille.astro';
import Button from '../ui/Button.astro';

const peinture = salles.find((s) => s.categorie === 'Peinture')!;
const image = realisations.find((r) => r.categorie === peinture.categorie)!;
const numero = etapes[0].numero;
const [avant, apres] = entree.titre.split(entree.accent);
---

<Salle id={entree.id} labelledby="entree-h1" numero={numero} image={image} alt={entree.alt} side="left" eager compact premiere>
  <div class="flex flex-col items-start gap-space-md md:pt-chrome">
    <div class="flex flex-wrap items-center gap-x-space-md gap-y-space-xs">
      <Pastille>{entree.eyebrow}</Pastille>
      <p class="label-md">{salleSur(numero)}</p>
    </div>
    <h1 id="entree-h1" class="font-display text-title-md md:text-headline-sm">
      {hero.brand} <span class="font-city text-city-on-dark">{hero.name}</span>
      <span class="sr-only"> — {hero.srOnly}</span>
    </h1>
    <p class="text-balance font-display text-headline-lg-mobile md:text-headline-lg">
      <span class="salle-line">
        <span class="salle-line-inner" style="--line:0">{avant}<span class="salle-accent">{entree.accent}</span>{apres}</span>
      </span>
    </p>
    <p class="max-w-prose text-body-lg">{entree.texte}</p>
    <div class="mt-space-sm flex flex-wrap gap-space-md">
      <Button variant="accent" href={entree.cta.href} icon="arrow-right">{entree.cta.label}</Button>
      <Button variant="secondary-light" href={entree.rdv.href}>{entree.rdv.label}</Button>
    </div>
  </div>
</Salle>
