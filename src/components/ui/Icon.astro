// Icônes au trait (stroke) plutôt qu'en aplat (fill).
const strokeIcons: IconName[] = ['arrow-right'];
const isStroke = strokeIcons.includes(name);
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={isStroke ? 'none' : 'currentColor'}
  stroke={isStroke ? 'currentColor' : undefined}
  stroke-width={isStroke ? 2 : undefined}
  stroke-linecap={isStroke ? 'round' : undefined}
  stroke-linejoin={isStroke ? 'round' : undefined}
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} />
</svg>
