---
// Titre de section : Montserrat Light, pas d'étiquette au-dessus. Un trait terracotta en biais signe la marque.
interface Props {
  title: string;
  id?: string;
  class?: string;
}

const { title, id, class: className = '' } = Astro.props;
---

<div class={`flex flex-col gap-space-md ${className}`}>
  <h2 id={id} class="max-w-3xl text-balance font-display text-headline-lg-mobile md:text-headline-lg">{title}</h2>
  <span class="para block h-1.5 w-24 bg-city [--skew:0.5rem]" aria-hidden="true"></span>
</div>
