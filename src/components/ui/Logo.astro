---
import { site } from '../../data/site';

interface Props {
  /** La taille se règle par la font-size du parent (tout est en em). */
  class?: string;
  /** Signature affichée sous le nom. */
  slogan?: string;
  /** Classes du slogan (ex. `max-xs:sr-only` : masqué visuellement, conservé pour le nom accessible). */
  sloganClass?: string;
}

const { class: className, slogan, sloganClass } = Astro.props;
const city = site.name.replace(`${site.parent.name} `, '');
---

<span class:list={['inline-flex items-center gap-[0.7em]', className]}>
  <img src={site.logo.markDarkWebp} alt="" width="144" height="144" class="h-[2.7em] w-auto" decoding="async" />
  <span class="flex flex-col leading-none">
    <span class="font-wordmark uppercase tracking-wordmark">{site.parent.name}</span>
    <span class="mt-[0.3em] font-city italic text-[1.2em] tracking-city text-city-on-dark">{city}</span>
    {slogan && <span class:list={['mt-[0.45em] pl-(--tracking-slogan) whitespace-nowrap font-slogan text-slogan uppercase opacity-80', sloganClass]}>{slogan}</span>}
  </span>
</span>
