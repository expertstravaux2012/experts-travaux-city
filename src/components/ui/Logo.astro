---
import { site } from '../../data/site';

interface Props {
  /** La taille se règle par la font-size du parent (tout est en em). */
  class?: string;
  /** Signature affichée sous le nom. */
  slogan?: string;
}

const { class: className, slogan } = Astro.props;
const city = site.name.replace(`${site.parent.name} `, '');
---

<span class:list={['inline-flex items-center gap-[0.7em]', className]}>
  <img src={site.logo.markDarkWebp} alt="" width="144" height="144" class="h-[2.7em] w-auto" decoding="async" />
  <span class="flex flex-col leading-none">
    <span class="font-wordmark uppercase tracking-wordmark">{site.parent.name}</span>
    <span class="mt-[0.3em] font-city text-[1.2em] font-light tracking-city text-city-on-dark">{city}</span>
    {slogan && <span class="mt-[0.45em] text-[0.62em] font-medium leading-none tracking-slogan opacity-80">{slogan}</span>}
  </span>
</span>
