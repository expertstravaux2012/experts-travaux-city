---
// Cadre d'une salle plein écran : photo, voile, (calque de lumière), numéro en contour, puis panneau en biais (slot).
// Le contenu du panneau est fourni par la section (Salles, Entree). Le panneau précède la porte, dernier enfant du DOM.
import { imageSrcset, type Realisation } from '../../data/realisations';
import Porte from './Porte.astro';

interface Props {
  id: string;
  /** Id du titre qui nomme la région. */
  labelledby: string;
  /** Numéro décoratif en contour (« 03 »). */
  numero: string;
  image: Pick<Realisation, 'image' | 'width' | 'height'>;
  /** Srcset de l'image si ses variantes ne suivent pas 480/800/1600. */
  srcset?: string;
  /** Variante portrait (3:4) sous md et sur écran vertical, avec son propre srcset. */
  portrait?: { srcset: string; width: number; height: number };
  /** Classes de l'image (ex. cadrage sous md). */
  photoClass?: string;
  alt: string;
  tone?: 'dark' | 'light';
  side?: 'left' | 'right';
  /** Image du premier écran (LCP) : chargement immédiat, haute priorité. */
  eager?: boolean;
  /** Calque de lumière qui suit le pointeur (Luminaires). */
  lumiere?: boolean;
  /** Panneau compact sous md (photo visible) : pour les textes longs. */
  compact?: boolean;
  /** Entrée du showroom : porte de sortie seule. */
  premiere?: boolean;
  /** Voile en haut de salle pour garder les liens du header lisibles sur la photo. */
  voileHeader?: boolean;
}

const { id, labelledby, numero, image, srcset, portrait, photoClass, alt, tone = 'dark', side = 'left', eager = false, lumiere = false, compact = false, premiere = false, voileHeader = false } = Astro.props;

const toneClass = tone === 'dark' ? 'salle-dark' : 'salle-light';
const numberSide = side === 'left' ? 'right-0' : 'left-0';
---

<section id={id} aria-labelledby={labelledby} data-salle data-side={side} class:list={['salle-frame', toneClass]}>
  <picture class="contents">
    {portrait && <source media="(max-width: 47.99rem), (max-aspect-ratio: 1/1)" srcset={portrait.srcset} sizes="100vw" width={portrait.width} height={portrait.height} />}
  <img
    src={image.image}
    srcset={srcset ?? imageSrcset(image.image)}
    sizes="100vw"
    width={image.width}
    height={image.height}
    alt={alt}
    aria-hidden={alt === '' ? 'true' : undefined}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    class:list={['salle-photo', photoClass]}
  />
  </picture>
  <div class="salle-scrim" aria-hidden="true"></div>
  {voileHeader && <div class="salle-scrim-header" aria-hidden="true"></div>}
  {lumiere && <div class="salle-light-layer" aria-hidden="true"></div>}
  <span
    class={`salle-number-outline absolute top-0 font-display text-salle-number md:top-auto md:bottom-0 ${numberSide}`}
    aria-hidden="true">{numero}</span
  >
  <div class:list={['salle-panel', compact && 'salle-panel-compact']}>
    <slot />
  </div>
  <Porte position={premiere ? 'first' : 'mid'} />
</section>
